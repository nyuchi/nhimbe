# Cloudflare Workers Development Variables
# Copy this file to .dev.vars and fill in the values

# Secrets (use wrangler secret put for production)
# API_SECRET_KEY=your-secret-key

# MongoDB Atlas — connection string for document storage alongside D1
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/nhimbe?retryWrites=true&w=majority

# Stytch — only the project ID is needed (no secret required).
# Auth is handled entirely by the Stytch frontend SDK.
# The backend validates session JWTs locally via Stytch's public JWKS.
WORKOS_CLIENT_ID=REPLACE_WITH_WORKOS_CLIENT_ID

# Supabase nyuchi_platform_db — service-role key for trusted server-side reads
# (bypasses RLS — only used in the worker, never sent to the browser).
# In production: `wrangler secret put SUPABASE_SERVICE_ROLE_KEY`.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

# Supabase nyuchi_pay_db — shared secret for the payments-api Edge Function.
# The same value must be set as a Supabase secret on the pay-db project
# (Supabase Dashboard → Settings → Edge Functions → Secrets) and as a worker
# secret here (`wrangler secret put PAY_API_KEY`). Generate a strong random
# string (e.g. `openssl rand -hex 32`); rotate by updating both sides.
PAY_API_KEY=REPLACE_WITH_SHARED_SECRET
