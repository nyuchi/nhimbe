# nhimbe-mcp — local development variables.
# Copy this file to `.dev.vars` and adjust. The MCP server owns no secrets:
# it reads/writes through the nhimbe app API, so there is almost nothing here.

# Base origin of the nhimbe app the MCP tools call. Point at your local app
# (default dev port 11825) or a preview deployment.
APP_API_URL=http://localhost:11825

# Display name advertised in the MCP `initialize` handshake.
MCP_SERVER_NAME=nhimbe (dev)
