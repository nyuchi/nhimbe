{
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules",
    "**/node_modules/**",
    ".next",
    ".next/**",
    "**/CHANGELOG.md",
  ],
  "config": {
    "default": true,
    "MD013": false,
    "MD022": false,
    "MD024": { "siblings_only": true },
    "MD025": { "front_matter_title": "" },
    "MD031": false,
    "MD032": false,
    "MD033": false,
    "MD034": false,
    "MD036": false,
    "MD040": false,
    "MD041": false,
    "MD046": false,
    "MD047": false,
    "MD001": false,
    "MD060": false,
  },
}
